#!/bin/sh

[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || exit 0
[ -S /var/run/io.cno.mihomo/control.sock ] || exit 0

# Reconcile asynchronously. The daemon serializes it with UI operations, and a
# failed reconciliation withdraws only resources recorded in its ownership
# journal so unrelated policy routing remains untouched.
(
	printf '%s\n' '{}' | /usr/sbin/cno-mihomoctl network.reconcile >/dev/null 2>&1
) &

exit 0
