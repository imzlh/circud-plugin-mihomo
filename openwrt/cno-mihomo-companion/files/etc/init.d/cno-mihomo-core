#!/bin/sh /etc/rc.common

START=95
STOP=09
USE_PROCD=1

ACTIVE=/var/lib/io.cno.mihomo/active.yaml
WORKDIR=/var/lib/io.cno.mihomo/runtime

start_service() {
	[ -s "$ACTIVE" ] || return 1
	mkdir -p "$WORKDIR"
	chmod 0700 /var/lib/io.cno.mihomo "$WORKDIR" 2>/dev/null || true

	procd_open_instance
	procd_set_param command /usr/bin/mihomo -d "$WORKDIR" -f "$ACTIVE"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_set_param file "$ACTIVE"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger io.cno.mihomo
}
